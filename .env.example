# Server-side only. NOTHING here may be prefixed NEXT_PUBLIC_: these values must never reach the browser.

# The StoreKit API, including /v1. Production: https://api.storekit.site/v1
# Staging:    https://api-staging.storekit.site/v1
API_BASE_URL=http://localhost:8787/v1

# The storefront ROOT: a store is served at {slug}.<this host>. Must equal the API's STOREFRONT_BASE_URL.
# Production: https://storekit.site      Local: http://lvh.me:3000 (*.lvh.me resolves to 127.0.0.1)
STOREFRONT_ROOT_URL=http://lvh.me:3000

# Shared with the API (its EDGE_SHARED_SECRET / SSM /storekit/<stage>/edge-shared-secret). At least 32 characters.
# Sent with every server-to-server call, together with the shopper's IP, so the API rate-limits shoppers and not
# this server. Required in production; leave unset locally and the API sees this server's own address.
# EDGE_SHARED_SECRET=

# Which request header carries the shopper's real address at this deployment's edge. Default: cf-connecting-ip
# (Cloudflare). Only correct if the origin is reachable only through that edge. Unset or invalid: no IP is forwarded.
# CLIENT_IP_HEADER=cf-connecting-ip
